{
  "schemaVersion": 1,
  "id": "media-and-files",
  "title": "Media and files (CDN + object storage)",
  "summary": "For images, video and downloads: large objects served from the edge, with object storage as the origin.",
  "requestsPerUserPerDay": 20,
  "peakFactor": 5,
  "readRatio": 0.98,
  "slo": {
    "p95Ms": 300,
    "maxErrorRate": 0.01
  },
  "serverProfile": {
    "os": "linux",
    "cpuCores": 4,
    "cpuGhz": 2.5,
    "ramGb": 16,
    "disk": {
      "kind": "ssd",
      "iops": 20000
    },
    "network": {
      "bandwidthMbps": 1000,
      "latencyMs": 0.5
    },
    "virtualization": "vm",
    "fdLimit": 65536
  },
  "topology": {
    "nodes": [
      {
        "id": "c",
        "kind": "client",
        "label": "Users",
        "position": {
          "x": 0,
          "y": 120
        },
        "template": null,
        "settings": {},
        "replicas": 1
      },
      {
        "id": "cdn",
        "kind": "cdn",
        "label": "CDN",
        "position": {
          "x": 260,
          "y": 120
        },
        "template": {
          "id": "cdn",
          "version": 1
        },
        "settings": {
          "hit_ratio": 0.95
        },
        "replicas": 1
      },
      {
        "id": "s3",
        "kind": "objectStorage",
        "label": "Object storage",
        "position": {
          "x": 520,
          "y": 120
        },
        "template": {
          "id": "s3",
          "version": 1
        },
        "settings": {
          "object_kb": 512
        },
        "replicas": 1
      }
    ],
    "edges": [
      {
        "id": "e-c-cdn",
        "source": "c",
        "target": "cdn"
      },
      {
        "id": "e-cdn-s3",
        "source": "cdn",
        "target": "s3"
      }
    ]
  },
  "tiers": [
    {
      "id": "100k",
      "label": "100 thousand daily users",
      "dailyUsers": 100000,
      "runS": 60,
      "replicas": {
        "s3": 1
      }
    },
    {
      "id": "1m",
      "label": "1 million daily users",
      "dailyUsers": 1000000,
      "runS": 60,
      "replicas": {
        "s3": 2,
        "cdn": 1
      }
    },
    {
      "id": "10m",
      "label": "10 million daily users",
      "dailyUsers": 10000000,
      "runS": 20,
      "replicas": {
        "s3": 10,
        "cdn": 4
      }
    }
  ],
  "why": [
    "Large objects are limited by network bandwidth, so every request the CDN answers saves bandwidth at the origin.",
    "Object storage scales by adding copies, each with its own network link.",
    "The CDN hit ratio is the number to watch: at 95% the origin sees one request in twenty."
  ]
}
