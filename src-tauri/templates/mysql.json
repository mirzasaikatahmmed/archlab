{
  "schemaVersion": 1,
  "id": "mysql",
  "version": 1,
  "name": "MySQL",
  "description": "Relational database (InnoDB) with common connection and memory settings.",
  "nodeKinds": ["database"],
  "settings": [
    {
      "key": "max_connections",
      "label": "Max connections",
      "unit": "conn",
      "default": 151,
      "min": 1,
      "max": 100000,
      "description": "Maximum concurrent client connections."
    },
    {
      "key": "innodb_buffer_pool_mb",
      "label": "InnoDB buffer pool",
      "unit": "MB",
      "default": 128,
      "min": 16,
      "max": 4194304,
      "description": "Memory used for caching table and index data."
    }
  ],
  "sim": {
    "baseServiceMs": 3.5,
    "cpuFraction": 0.4,
    "sigma": 0.8,
    "writeMultiplier": 3,
    "concurrencyPerUnit": 1,
    "defaultQueue": 256,
    "concurrencySetting": "max_connections"
  }
}
