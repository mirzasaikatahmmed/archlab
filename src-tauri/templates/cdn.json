{
  "schemaVersion": 1,
  "id": "cdn",
  "version": 1,
  "name": "CDN edge",
  "description": "Content delivery network edge: serves a share of reads from the edge so they never reach the origin.",
  "nodeKinds": ["cdn"],
  "settings": [
    {
      "key": "edge_workers",
      "label": "Edge workers",
      "unit": "workers",
      "default": 64,
      "min": 1,
      "max": 100000,
      "description": "Parallel requests the edge handles."
    },
    {
      "key": "hit_ratio",
      "label": "Cache hit ratio",
      "unit": "ratio",
      "default": 0.9,
      "min": 0,
      "max": 1,
      "description": "Fraction of reads served from the edge. Writes always go to the origin."
    }
  ],
  "sim": {
    "baseServiceMs": 0.15,
    "cpuFraction": 0.8,
    "sigma": 0.4,
    "writeMultiplier": 1,
    "concurrencyPerUnit": 1,
    "defaultQueue": 4096,
    "concurrencySetting": "edge_workers",
    "hitRatioSetting": "hit_ratio"
  }
}
