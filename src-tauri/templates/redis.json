{
  "schemaVersion": 1,
  "id": "redis",
  "version": 2,
  "name": "Redis",
  "description": "In-memory key-value store used as cache or queue.",
  "nodeKinds": ["cache", "queue"],
  "settings": [
    {
      "key": "maxmemory_mb",
      "label": "Max memory",
      "unit": "MB",
      "default": 1024,
      "min": 16,
      "max": 4194304,
      "description": "Memory limit before eviction applies."
    },
    {
      "key": "io_threads",
      "label": "I/O threads",
      "unit": "threads",
      "default": 1,
      "min": 1,
      "max": 128,
      "description": "Threads used for socket reads and writes."
    },
    {
      "key": "maxclients",
      "label": "Max clients",
      "unit": "conn",
      "default": 10000,
      "min": 1,
      "max": 1000000,
      "description": "Maximum simultaneous client connections."
    },
    {
      "key": "tcp_backlog",
      "label": "TCP backlog",
      "unit": "conn",
      "default": 511,
      "min": 1,
      "max": 65535,
      "description": "Pending connection queue length."
    },
    {
      "key": "hit_ratio",
      "label": "Cache hit ratio",
      "unit": "ratio",
      "default": 0.8,
      "min": 0,
      "max": 1,
      "description": "Fraction of reads served from the cache (cache nodes only)."
    }
  ],
  "sim": {
    "baseServiceMs": 0.05,
    "cpuFraction": 0.8,
    "sigma": 0.4,
    "writeMultiplier": 1,
    "concurrencySetting": "io_threads",
    "concurrencyPerUnit": 1,
    "queueSetting": "maxclients",
    "defaultQueue": 1024,
    "hitRatioSetting": "hit_ratio"
  }
}
