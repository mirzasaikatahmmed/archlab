{
  "schemaVersion": 1,
  "id": "redis",
  "version": 1,
  "name": "Redis",
  "description": "In-memory key-value store used as cache or queue.",
  "nodeKinds": ["cache", "queue"],
  "settings": [
    {
      "key": "maxmemory_mb",
      "label": "Max memory",
      "unit": "MB",
      "default": 1024,
      "min": 16,
      "max": 4194304,
      "description": "Memory limit before eviction applies."
    },
    {
      "key": "io_threads",
      "label": "I/O threads",
      "unit": "threads",
      "default": 1,
      "min": 1,
      "max": 128,
      "description": "Threads used for socket reads and writes."
    },
    {
      "key": "maxclients",
      "label": "Max clients",
      "unit": "conn",
      "default": 10000,
      "min": 1,
      "max": 1000000,
      "description": "Maximum simultaneous client connections."
    },
    {
      "key": "tcp_backlog",
      "label": "TCP backlog",
      "unit": "conn",
      "default": 511,
      "min": 1,
      "max": 65535,
      "description": "Pending connection queue length."
    }
  ]
}
