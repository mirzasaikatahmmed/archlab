{
  "schemaVersion": 1,
  "id": "memcached",
  "version": 1,
  "name": "Memcached",
  "description": "In-memory key-value cache with a thread pool.",
  "nodeKinds": ["cache"],
  "settings": [
    {
      "key": "threads",
      "label": "Threads",
      "unit": "threads",
      "default": 4,
      "min": 1,
      "max": 128,
      "description": "Worker threads (-t)."
    },
    {
      "key": "max_connections",
      "label": "Max connections",
      "unit": "conn",
      "default": 1024,
      "min": 1,
      "max": 1000000,
      "description": "Simultaneous client connections (-c)."
    },
    {
      "key": "hit_ratio",
      "label": "Cache hit ratio",
      "unit": "ratio",
      "default": 0.8,
      "min": 0,
      "max": 1,
      "description": "Fraction of reads served from the cache."
    }
  ],
  "sim": {
    "baseServiceMs": 0.08,
    "cpuFraction": 0.8,
    "sigma": 0.4,
    "writeMultiplier": 1,
    "concurrencyPerUnit": 1,
    "defaultQueue": 1024,
    "concurrencySetting": "threads",
    "queueSetting": "max_connections",
    "hitRatioSetting": "hit_ratio"
  }
}
