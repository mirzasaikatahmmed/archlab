{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArchLab",
  "version": "0.1.0",
  "identifier": "dev.archlab.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArchLab",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ArchLab contributors",
    "copyright": "Copyright (c) 2026 ArchLab contributors",
    "category": "DeveloperTool",
    "shortDescription": "Capacity planning and distributed-system simulation",
    "longDescription": "ArchLab simulates how a server design behaves under load, faults and change, entirely on your computer. Results are estimates.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1NkYwNEEzOTlGNkQxMTEKUldRUjBmYVpvd1J2VmRURnV5QThIRVFJeWdrSzlyRzJFREFJbldtWFBIbktHTHpXeVJya2dzOWkK",
      "endpoints": [
        "https://github.com/mirzasaikatahmmed/archlab/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
